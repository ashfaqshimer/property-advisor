# The base URL for the backend API.
# In local development, this points directly to the FastAPI server.
# In production, set this to `/api` to route traffic through the Next.js reverse proxy.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# The actual destination URL of the backend (e.g., https://your-backend.onrender.com).
# Required ONLY in production when NEXT_PUBLIC_API_URL is set to `/api`.
# This is used by next.config.ts to proxy requests.
BACKEND_URL=
