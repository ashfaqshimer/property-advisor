# Copy to .env and fill in. .env is gitignored; this file is not.

# Neon Postgres. Use the DIRECT (non-pooled) endpoint and keep sslmode=require —
# Neon refuses unencrypted connections, and the error it returns doesn't say so.
DATABASE_URL=postgresql://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Only needed if DATABASE_URL points at the `-pooler` endpoint. Alembic runs DDL and
# wants a plain session, not PgBouncer transaction pooling. (That mode also needs
# psycopg's prepare_threshold disabled on the app engine — see app/db/session.py.)
# MIGRATION_DATABASE_URL=

# Comma-separated origins allowed to call this API from a browser.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Agent settings.
GEMINI_API_KEY=
GEMINI_MODEL=
GOOGLE_MAPS_API_KEY=
LOCATION_SEARCH_RADIUS_KM=5

# Cloudinary image storage for property listings.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=property-advisor

# Staff auth. Use AUTH_COOKIE_SECURE=true and AUTH_COOKIE_SAMESITE=none in production
# when the frontend and API are hosted on different sites.
AUTH_COOKIE_NAME=property_advisor_session
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# One-time secret required by `uv run python -m scripts.create_admin`.
# Store this only in your local environment or Render environment settings.
BOOTSTRAP_ADMIN_SECRET=
